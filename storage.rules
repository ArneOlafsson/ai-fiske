rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdminEmail() {
      return request.auth != null && request.auth.token.email != null && (
        request.auth.token.email == 'arne@olafsson.se' ||
        request.auth.token.email == 'arne.olafsson@gmail.com' ||
        request.auth.token.email == 'johan@animaldeli.com' ||
        request.auth.token.email == 'johan@bertlid.se' ||
        request.auth.token.email == 'arvid.bertlid@icloud.com'
      );
    }

    match /catches/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        isAdminEmail()
      );
    }
    
    match /tips/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdminEmail();
    }

    match /tips/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        isAdminEmail()
      );
    }
    
    match /equipment/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdminEmail();
    }

    match /equipment/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        isAdminEmail()
      );
    }
  }
}

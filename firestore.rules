rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdminUser() {
      return request.auth != null && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'arne@olafsson.se' ||
          request.auth.token.email == 'arne.olafsson@gmail.com' ||
          request.auth.token.email == 'johan@animaldeli.com' ||
          request.auth.token.email == 'johan@bertlid.se' ||
          request.auth.token.email == 'arvid.bertlid@icloud.com'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function passesClientVersionGate() {
      return !exists(/databases/$(database)/documents/config/app) ||
             get(/databases/$(database)/documents/config/app).data.enforceMinClientVersionOnWrites != true ||
             (request.resource.data.clientVersionInt is int &&
              request.resource.data.clientVersionInt >= get(/databases/$(database)/documents/config/app).data.minClientVersionInt);
    }

    // Remote App Config (paywall date, minAppVersion, store links)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdminUser();
    }
    
    // User Profiles (protect server-controlled premium fields from client self-upgrade)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        isAdminUser() ||
        (request.auth.uid == userId &&
         (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false))
      );
      allow update: if request.auth != null && (
        isAdminUser() ||
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'isPremium',
           'premiumType',
           'premiumExpiresAt',
           'premiumSource',
           'grantedBy',
           'role'
         ]))
      );
      allow delete: if isAdminUser();
    }

    // Catches Collection
    match /catches/{catchId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid &&
        passesClientVersionGate();
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        isAdminUser()
      );
      
      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          request.resource.data.uid == request.auth.uid &&
          passesClientVersionGate();
        allow delete: if request.auth != null && (
          resource.data.uid == request.auth.uid ||
          isAdminUser()
        );
      }
    }

    // Chat History
    match /chats/{userId}/messages/{messageId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Likes Collection (Root level)
    match /likes/{likeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Tips & Trix Posts
    match /posts/{postId} {
      allow read: if true;
      allow create, delete: if isAdminUser();
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']) ||
        isAdminUser()
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create, update: if request.auth != null &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPremium == true;
        allow delete: if request.auth != null && (
          resource.data.uid == request.auth.uid ||
          isAdminUser()
        );
      }
    }
    
    // Equipment & Bete
    match /equipment/{equipmentId} {
      allow read: if true;
      allow create, delete: if isAdminUser();
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']) ||
        isAdminUser()
      );
      
      match /comments/{commentId} {
        allow read: if true;
        allow create, update: if request.auth != null &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPremium == true;
        allow delete: if request.auth != null && (
          resource.data.uid == request.auth.uid ||
          isAdminUser()
        );
      }
    }

    // PRO VIP Klubb Events & Deals
    match /vip_events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdminUser();
    }

    // Time-controlled Campaign & Partner Ads
    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdminUser();
    }

    // Daily Spots ("Vart hittade vi fisken idag")
    match /daily_spots/{spotId} {
      allow read: if true;
      allow create: if request.auth != null && passesClientVersionGate();
      allow update: if request.auth != null;
      allow delete: if isAdminUser();
    }
  }
}
